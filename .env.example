# Database
DATABASE_URL="postgresql://user:password@localhost:5432/securitymatch"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to false only for a local development environment without email delivery.
EMAIL_VERIFICATION_REQUIRED="false"

# Email delivery (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="SecurityMatch <onboarding@resend.dev>"

# Public legal business details. These must be completed before public launch.
NEXT_PUBLIC_LEGAL_BRAND_NAME="SecurityMatch"
NEXT_PUBLIC_LEGAL_ENTITY_NAME=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_LEGAL_POSTAL_CODE=""
NEXT_PUBLIC_LEGAL_CITY=""
NEXT_PUBLIC_LEGAL_KVK_NUMBER=""
NEXT_PUBLIC_LEGAL_VAT_NUMBER=""
NEXT_PUBLIC_LEGAL_EMAIL=""
NEXT_PUBLIC_LEGAL_PRIVACY_EMAIL=""
NEXT_PUBLIC_LEGAL_PHONE=""

# Private document storage (required for document verification)
BLOB_READ_WRITE_TOKEN="vercel_blob_replace_me"

# Public application URL used in verification and password-reset links
APP_URL="http://localhost:3000"

# Stripe: test mode only. Live keys (sk_live_) are intentionally rejected by the app.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
